# Copiar a backend/.env (no se versiona) y completar.
ENV=dev                         # dev | prod  (en prod se deshabilita /docs)
API_KEY=cambiar-por-una-clave-larga-aleatoria
ALLOWED_ORIGINS=http://localhost:5173
DATA_DIR=../data
TIMEZONE=America/Santiago       # zona de los timestamps de los archivos de datos
FRED_API_KEY=                   # Stock_Tendencia (datos macro)

# --- Corridas batch (python -m fog_radar.jobs; ver deploy/backend/README.md) ---
# PIPELINE_PAUSA_S=60                 # pausa entre pipelines de una secuencia
# PIPELINE_REINTENTOS=1               # reintentos en corridas del cron (manual: 0)
# PIPELINE_ESPERA_REINTENTO_S=600
# PIPELINE_LOCK_ESPERA_S=21600        # cron: esperar si otra corrida tiene el lock
# ALERT_WEBHOOK_URL=                  # aviso si falla un pipeline (Slack/Discord/Teams)

# Cliente común de Yahoo Finance (fog_radar.core.yahoo): reglas para todo el proceso
# YAHOO_MIN_INTERVALO_S=0.35          # mínimo entre dos requests (todos los módulos e hilos)
# YAHOO_JITTER_S=0.25                 # + espera aleatoria de 0 a este valor
# YAHOO_REINTENTOS_429=3              # reintentos ante HTTP 429 (backoff exponencial)
# YAHOO_BACKOFF_BASE_S=5
# YAHOO_BACKOFF_MAX_S=60
# YAHOO_REINTENTOS_RED=2              # errores de red transitorios (yfinance)
