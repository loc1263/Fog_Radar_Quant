# Enrutamiento por prefijo durante la migración del backend a Go (estrangulador).
# Cada prefijo apunta a Go o a Python; para volver atrás basta mover el prefijo al bloque de Python
# y recargar (`caddy reload`). El frontend (BFF) solo conoce esta dirección: no cambia nada.
#
# Estado: Go sirve las 61 rutas de /api (sistema, hub, buscador, cl, us, etf, tendencia) con el mismo contrato.
# Para migrar por etapas, reemplaza el matcher @go por una lista de prefijos (p. ej. solo /api/cl/*).

:8080 {
	encode zstd gzip

	# --- Go (puerto 8000) ---------------------------------------------------------------
	@go path /api/*
	handle @go {
		# Primero Go; si no conecta (caído), Python atiende la misma ruta con el mismo contrato.
		reverse_proxy go-api:8000 py-api:8001 {
			lb_policy first
			lb_try_duration 2s
			fail_duration 10s
		}
	}

	# --- Python (puerto 8001): todo lo que Go aún no migró --------------------------------
	handle {
		reverse_proxy py-api:8001
	}
}
