# Copiar a backend-go/.env (no se versiona) y completar. Una variable de entorno gana al .env.
ENV=dev                         # dev | prod  (en prod se deshabilita /docs)
ADDR=:8000
DATA_DIR=../data
TIMEZONE=America/Santiago       # zona de los timestamps de los archivos de datos
LOG_LEVEL=INFO
FRED_API_KEY=                   # datos macro de Tendencia

# --- Corridas batch (fogradar job) ---
# RETENCION_DIAS=7                    # días de datos que se conservan en data/ (0 = no borrar nada)
# PIPELINE_PAUSA_S=60                 # pausa entre pipelines, solo si el anterior falló o recibió 429

# Cliente común de Yahoo Finance: reglas para todo el proceso
# YAHOO_MIN_INTERVALO_S=0.35          # mínimo entre dos requests (todos los módulos e hilos); con el modo
#                                     # adaptivo es el intervalo seguro al que se vuelve tras un 429
# YAHOO_ADAPTATIVO=true               # espaciado adaptivo: parte rápido y se ensancha solo ante un 429
# YAHOO_INTERVALO_RAPIDO_S=0.2        # intervalo inicial del modo adaptivo (debe ser menor que el mínimo)
# YAHOO_JITTER_S=0.25                 # + espera aleatoria de 0 a este valor
# YAHOO_CONCURRENCIA=4
# YAHOO_REINTENTOS_429=3              # reintentos ante HTTP 429 (backoff exponencial)
# YAHOO_BACKOFF_BASE_S=5
# YAHOO_BACKOFF_MAX_S=60
# YAHOO_REINTENTOS_RED=2              # errores de red transitorios
