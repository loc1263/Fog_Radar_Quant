# Copiar a frontend/.env (no se versiona).
# Variables PRIVADAS: solo las lee el servidor SvelteKit (nunca llegan al navegador).
PRIVATE_API_URL=http://localhost:8000
# Debe coincidir con API_KEY del backend (vacía en dev si el backend no la exige).
PRIVATE_API_KEY=

